{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sb-web-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "local",
    "BILLING_MODE": "disabled",
    "EMAIL_MODE": "log",
    "EMAIL_FALLBACK_UI": "1",
    "AIRTABLE_CRON": "0",
    "NEXT_INC_CACHE_R2_PREFIX": "open-next-cache",
    "R2_BUCKET_NAME": "sb-files-dev"
  },
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "sb-files-dev" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sb-files-dev" }
  ],
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "sb-web-local" }
  ],
  "env": {
    "preview": {
      "name": "sb-web-preview",
      "vars": {
        "APP_ENV": "preview",
        "ADMIN_AUTH_PROVIDER": "better-auth",
        "BETTER_AUTH_URL": "https://sb-web-preview.yi-ding.workers.dev",
        "BILLING_MODE": "disabled",
        // Preview sends for real now that mail.openboard.events is verified, but
        // only to the allowlist: a preview that can mail anybody is one bad
        // seed away from mailing a stranger.
        "EMAIL_MODE": "send",
        "EMAIL_FROM": "AI.Engineer Sandbox <hello@mail.openboard.events>",
        "EMAIL_ALLOWLIST": "yi.s.ding@gmail.com",
        "EMAIL_FALLBACK_UI": "1",
        "AIRTABLE_CRON": "0",
        "NEXT_INC_CACHE_R2_PREFIX": "open-next-cache",
        "R2_BUCKET_NAME": "sb-files-preview",
        "TEST_AUTH": "1"
      },
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "sb-files-preview" },
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sb-files-preview" }
      ],
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "sb-web-preview" }
      ]
    },
    "production": {
      "name": "sb-web",
      // Error 1042 fix, same as workers/jobs: the OpenNext runtime fetches its
      // own APP_BASE_URL (a same-account workers.dev host), which Cloudflare
      // refuses unless same-zone fetches are treated as public. Env-scoped so
      // the working preview config stays byte-identical.
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "vars": {
        "APP_ENV": "production",
        "ADMIN_AUTH_PROVIDER": "better-auth",
        "BETTER_AUTH_URL": "https://sb-web.yi-ding.workers.dev",
        "BILLING_MODE": "disabled",
        "EMAIL_MODE": "send",
        "EMAIL_FROM": "AI.Engineer Sandbox <hello@mail.openboard.events>",
        "EMAIL_FALLBACK_UI": "0",
        "AIRTABLE_CRON": "0",
        "NEXT_INC_CACHE_R2_PREFIX": "open-next-cache",
        "R2_BUCKET_NAME": "sb-files"
      },
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "sb-files" },
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sb-files" }
      ],
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "sb-web" }
      ]
    }
  }
}
