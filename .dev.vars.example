APP_ENV=local
DATABASE_URL=
DATABASE_URL_DIRECT=
SESSION_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
UNSUBSCRIBE_SECRET=
SPEAKER_SHARE_SECRET=
BILLING_WEBHOOK_SECRET=
BILLING_MODE=disabled
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_MODE=log
EMAIL_ALLOWLIST=
EMAIL_FALLBACK_UI=1
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_CRON=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sb-files-dev
APP_BASE_URL=http://localhost:3000
BUILD_SHA=local

# Optional. Google social login for admins; must be set as a pair. Register the
# redirect URI <origin>/api/auth/callback/google in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional origin override for Better Auth's callback and email links; defaults
# to APP_BASE_URL. Origin only — no path, no trailing slash.
BETTER_AUTH_URL=

# Optional reviewed signup-policy set. Leave all four empty until the Terms and
# Privacy documents are approved and published; setting any one requires all
# four and activates exact-version consent enforcement for new accounts.
LEGAL_TERMS_URL=
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_URL=
LEGAL_PRIVACY_VERSION=
