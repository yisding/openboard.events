{
  "name": "openboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "invariants": "bash scripts/check-invariants.sh",
    "audit:prod": "pnpm audit --prod --audit-level=low",
    "check": "pnpm typecheck && pnpm lint && pnpm invariants && pnpm test && pnpm build && pnpm build:worker",
    "cf-typegen": "bash scripts/check-cloudflare-types.sh --write",
    "cf-typegen:check": "bash scripts/check-cloudflare-types.sh",
    "build:worker": "bash scripts/build-worker-clean.sh",
    "worker:size": "bash scripts/check-worker-size.sh",
    "smoke:worker": "bash scripts/smoke-worker-artifact.sh",
    "bundle:client": "tsx scripts/check-client-bundle.ts",
    "release:check": "pnpm typecheck && pnpm lint && pnpm invariants && pnpm audit:prod && pnpm test && pnpm cf-typegen:check && pnpm build:worker && pnpm bundle:client && pnpm worker:size && pnpm smoke:worker",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx scripts/seed/index.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "dev:jobs": "wrangler dev --config workers/jobs/wrangler.jsonc --test-scheduled --var APP_BASE_URL:http://localhost:3000",
    "deploy:web": "pnpm deploy:web:production",
    "deploy:web:preview": "bash scripts/deploy-cloudflare.sh web preview",
    "deploy:web:production": "bash scripts/deploy-cloudflare.sh web production",
    "deploy:jobs": "pnpm deploy:jobs:production",
    "deploy:jobs:preview": "bash scripts/deploy-cloudflare.sh jobs preview",
    "deploy:jobs:production": "bash scripts/deploy-cloudflare.sh jobs production",
    "deploy:preflight": "tsx scripts/check-deploy-secrets.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "1.1.0",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.6.26",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.1.3",
    "lucide-react": "^0.536.0",
    "next": "15.5.23",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "tailwind-merge": "^3.3.1",
    "xss": "^1.0.15",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/eslintrc": "^3.3.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.2.1",
    "@types/pg": "8.15.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.33.0",
    "eslint-config-next": "15.5.23",
    "pg": "8.16.3",
    "tsx": "4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.29.1"
  }
}
