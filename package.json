{
  "name": "openboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "invariants": "bash scripts/check-invariants.sh",
    "check": "pnpm typecheck && pnpm invariants && pnpm test && pnpm build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:web": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:jobs": "wrangler deploy --config workers/jobs/wrangler.jsonc"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.536.0",
    "next": "15.5.23",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "tailwind-merge": "^3.3.1",
    "xss": "^1.0.15",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "15.5.23",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.29.1"
  }
}
