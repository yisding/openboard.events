{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sb-jobs-local",
  "main": "index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": false,
  "triggers": { "crons": ["* * * * *"] },
  "services": [
    { "binding": "WEB_JOBS", "service": "sb-web-local", "entrypoint": "JobsEntrypoint" }
  ],
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "name": "sb-jobs-preview",
      "triggers": { "crons": ["* * * * *"] },
      "services": [
        { "binding": "WEB_JOBS", "service": "sb-web-preview", "entrypoint": "JobsEntrypoint" }
      ],
      "observability": { "enabled": true }
    },
    "production": {
      "name": "sb-jobs",
      "triggers": { "crons": ["* * * * *"] },
      "services": [
        { "binding": "WEB_JOBS", "service": "sb-web", "entrypoint": "JobsEntrypoint" }
      ],
      "observability": { "enabled": true }
    }
  }
}
