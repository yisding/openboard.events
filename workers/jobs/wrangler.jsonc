{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sb-jobs-local",
  "main": "index.ts",
  "compatibility_date": "2026-08-01",
  // Required when APP_BASE_URL targets a sibling Worker on the same workers.dev zone.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "triggers": { "crons": ["* * * * *"] },
  // Local/package and deploy scripts provide APP_BASE_URL; never commit a guessed workers.dev hostname.
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "name": "sb-jobs-preview",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true }
    },
    "production": {
      "name": "sb-jobs",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true }
    }
  }
}
