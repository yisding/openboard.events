{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sb-jobs-local",
  "main": "index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": false,
  "triggers": { "crons": ["* * * * *"] },
  "services": [
    { "binding": "WEB_JOBS", "service": "sb-web-local", "entrypoint": "JobsEntrypoint" }
  ],
  // The dispatcher reads AIRTABLE_CRON itself, before ever calling WEB_JOBS —
  // it decides whether to dispatch the "airtable" job at all, so the flag
  // lives on this Worker too, not only on the web Worker it forwards to.
  // Mirrors the value in the top-level wrangler.jsonc's three env blocks;
  // never change it here without changing it there in the same deploy.
  //
  // CLEANUP_CRON is this Worker's alone — nothing on the web side reads it.
  // "0" suspends the daily cleanup tick, which is the documented step after a
  // Neon point-in-time restore while R2 and Postgres may still disagree; see
  // docs/runbooks/backup-restore.md. Anything other than "0" (including the
  // variable being absent) leaves the sweep running, because a retention sweep
  // must never be switched off by a typo.
  "vars": { "AIRTABLE_CRON": "1", "CLEANUP_CRON": "1" },
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "name": "sb-jobs-preview",
      "triggers": { "crons": ["* * * * *"] },
      "services": [
        { "binding": "WEB_JOBS", "service": "sb-web-preview", "entrypoint": "JobsEntrypoint" }
      ],
      "vars": { "AIRTABLE_CRON": "1", "CLEANUP_CRON": "1" },
      "observability": { "enabled": true }
    },
    "production": {
      "name": "sb-jobs",
      "triggers": { "crons": ["* * * * *"] },
      "services": [
        { "binding": "WEB_JOBS", "service": "sb-web", "entrypoint": "JobsEntrypoint" }
      ],
      "vars": { "AIRTABLE_CRON": "1", "CLEANUP_CRON": "1" },
      "observability": { "enabled": true }
    }
  }
}
